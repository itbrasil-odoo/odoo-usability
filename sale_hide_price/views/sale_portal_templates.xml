<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_my_quotations_inherit_sale_hide_price"
        inherit_id="sale.portal_my_quotations"
        priority="99"
    >
        <xpath
            expr="//t[@t-if='quotations' and @t-call='portal.portal_table']"
            position="before"
        >
            <t
                t-set="has_visible_totals"
                t-value="bool(quotations.filtered('show_portal_so_total_amount'))"
            />
        </xpath>
        <xpath expr="//thead/tr/th[last()]" position="attributes">
            <attribute name="t-if">has_visible_totals</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='quotations']/tr/td[last()]" position="replace">
            <td t-if="has_visible_totals" class="text-end">
                <span
                    t-if="quotation.show_portal_so_total_amount"
                    t-field="quotation.amount_total"
                />
                <t t-else="">-</t>
            </td>
        </xpath>
    </template>

    <template
        id="portal_my_orders_inherit_sale_hide_price"
        inherit_id="sale.portal_my_orders"
        priority="99"
    >
        <xpath
            expr="//t[@t-if='orders' and @t-call='portal.portal_table']"
            position="before"
        >
            <t
                t-set="has_visible_totals"
                t-value="bool(orders.filtered('show_portal_so_total_amount'))"
            />
        </xpath>
        <xpath expr="//th[@name='order_total']" position="attributes">
            <attribute name="t-if">has_visible_totals</attribute>
        </xpath>
        <xpath expr="//td[@name='order_amount_total']" position="replace">
            <td t-if="has_visible_totals" name="order_amount_total" class="text-end">
                <span
                    t-if="order.show_portal_so_total_amount"
                    t-field="order.amount_total"
                />
                <t t-else="">-</t>
            </td>
        </xpath>
    </template>

    <template
        id="sale_order_portal_template_inherit_sale_hide_price"
        inherit_id="sale.sale_order_portal_template"
        priority="99"
    >
        <xpath
            expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_portal_sale_sidebar ')]"
            position="attributes"
        >
            <attribute name="t-att-data-order-amount-total">
                sale_order.amount_total if sale_order.show_portal_so_total_amount else None
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-call='portal.portal_record_sidebar']/t[@t-set='title']"
            position="replace"
        >
            <t t-set="title">
                <t t-if="sale_order.show_portal_so_total_amount">
                    <t
                        t-if="sale_order._has_to_be_paid() and sale_order.prepayment_percent != 1.0"
                    >
                        <h4>Down payment</h4>
                        <h2>
                            <t
                            t-out="sale_order._get_prepayment_required_amount()"
                            t-options="{
                                    'widget': 'monetary',
                                    'display_currency': sale_order.currency_id,
                                }"
                        />
                            (<t t-out="sale_order.prepayment_percent * 100" />%)
                        </h2>
                    </t>
                    <h2
                        t-else=""
                        t-field="sale_order.amount_total"
                        class="mb-0 text-break"
                    />
                </t>
                <t t-else="">
                    <h2 class="mb-0 text-break">
                        <t t-out="sale_order.type_name" /> -
                        <t t-out="sale_order.name" />
                    </h2>
                </t>
            </t>
        </xpath>
        <xpath
            expr="//div[@role='alert' and contains(concat(' ', normalize-space(@class), ' '), ' alert-success ')]"
            position="attributes"
        >
            <attribute name="t-if">
                sale_order.show_portal_so_total_amount
                and 0 &lt; sale_order.amount_paid &lt; sale_order.amount_total
                and sale_order.state != 'cancel'
            </attribute>
        </xpath>
        <xpath
            expr="//t[@t-if=&quot;not sale_order.is_expired and sale_order.state in ['draft', 'sent']&quot;]"
            position="attributes"
        >
            <attribute name="t-if">
                sale_order.show_portal_so_total_amount
                and not sale_order.is_expired
                and sale_order.state in ['draft', 'sent']
            </attribute>
        </xpath>
        <xpath expr="//t[@t-call='payment.state_header']" position="attributes">
            <attribute name="t-if">sale_order.show_portal_so_total_amount</attribute>
        </xpath>
    </template>

    <template
        id="sale_order_portal_sign_modal_inherit_sale_hide_price"
        inherit_id="sale.sale_order_portal_sign_modal"
        priority="99"
    >
        <xpath expr="//main[@id='sign-dialog']/span" position="replace">
            <span t-if="sale_order.show_portal_so_total_amount">
                By signing, you confirm acceptance on behalf of
                <b t-field="sale_order.partner_id.commercial_partner_id" />
                for the <b
                data-id="total_amount"
                t-field="sale_order.amount_total"
            /> quote.
            </span>
            <span t-else="">
                By signing, you confirm acceptance on behalf of
                <b t-field="sale_order.partner_id.commercial_partner_id" />
                for this quote.
            </span>
        </xpath>
    </template>

    <template
        id="sale_order_portal_pay_modal_inherit_sale_hide_price"
        inherit_id="sale.sale_order_portal_pay_modal"
        priority="99"
    >
        <xpath
            expr="//main[@id='sign-dialog']/div[@t-if='sale_order._has_to_be_paid()' and contains(concat(' ', normalize-space(@class), ' '), ' mb-3 ')]"
            position="replace"
        >
            <div t-if="sale_order._has_to_be_paid()" class="mb-3">
                <t t-if="sale_order.show_portal_so_total_amount">
                    <span t-if="prepayment_available">
                    <span id="o_sale_portal_use_amount_prepayment">
                            By paying a <u>down payment</u> of
                            <span
                        t-out="amount"
                        t-options="{
                                    'widget': 'monetary',
                                    'display_currency': sale_order.currency_id,
                                }"
                        class="fw-bold"
                    />
                            <t
                        t-if="sale_order._get_prepayment_required_amount() == amount"
                    >
                                (<b t-esc="sale_order.prepayment_percent * 100" />%),
                            </t>
                        </span>
                    <span id="o_sale_portal_use_amount_total">By paying,</span>
                </span>
                    <span t-else="">
                        By paying,
                        <span
                    t-out="amount"
                    t-options="{
                                'widget': 'monetary',
                                'display_currency': sale_order.currency_id,
                            }"
                    class="fw-bold"
                />
                    </span>
                    you confirm acceptance on behalf of
                    <b t-field="sale_order.partner_id.commercial_partner_id" />
                    for the <b
                    data-id="total_amount"
                    t-field="sale_order.amount_total"
                /> quote.
                </t>
                <t t-else="">
                    By paying, you confirm acceptance on behalf of
                    <b t-field="sale_order.partner_id.commercial_partner_id" />
                    for this quote.
                </t>
                <b
                    t-if="sale_order.payment_term_id"
                    t-field="sale_order.payment_term_id.note"
                    class="o_sale_payment_terms"
                />
            </div>
        </xpath>
        <xpath
            expr="//main[@id='sign-dialog']/div[@t-if='payment_amount and not sale_order._has_to_be_paid()']"
            position="attributes"
        >
            <attribute name="t-if">
                sale_order.show_portal_so_total_amount
                and payment_amount
                and not sale_order._has_to_be_paid()
            </attribute>
        </xpath>
    </template>

    <template
        id="sale_order_portal_pay_modal_amount_selector_inherit_sale_hide_price"
        inherit_id="sale.sale_order_portal_pay_modal_amount_selector"
        priority="99"
    >
        <xpath expr="//div[@role='group']" position="replace">
            <div class="d-flex btn-group mb-3" role="group">
                <button
                    name="o_sale_portal_amount_prepayment_button"
                    class="btn btn-light active"
                >
                    Down payment
                    <t t-if="sale_order.show_portal_so_total_amount">
                    <br />
                    <span
                        t-if="not payment_amount or payment_amount == sale_order.amount_total"
                        t-out="prepayment_amount"
                        t-options="{
                                'widget': 'monetary',
                                'display_currency': sale_order.currency_id,
                            }"
                        class="fw-bold"
                    />
                    <span
                        t-else=""
                        t-out="payment_amount"
                        t-options="{
                                'widget': 'monetary',
                                'display_currency': sale_order.currency_id,
                            }"
                        class="fw-bold"
                    />
                </t>
                </button>
                <button name="o_sale_portal_amount_total_button" class="btn btn-light">
                    Full amount
                    <t t-if="sale_order.show_portal_so_total_amount">
                    <br />
                    <span
                        t-out="sale_order.amount_total"
                        t-options="{
                                'widget': 'monetary',
                                'display_currency': sale_order.currency_id,
                            }"
                        class="fw-bold"
                    />
                </t>
                </button>
            </div>
        </xpath>
    </template>

    <template
        id="sale_order_portal_content_inherit_sale_hide_price"
        inherit_id="sale.sale_order_portal_content"
    >
        <xpath expr="//t[@t-set='display_discount']" position="before">
            <t t-set="show_line_values" t-value="sale_order.show_portal_values" />
            <t
                t-set="show_total_amount"
                t-value="sale_order.show_portal_so_total_amount"
            />
        </xpath>
        <xpath expr="//t[@t-set='display_discount']" position="attributes">
            <attribute name="t-value">
                show_line_values and any(line.discount &gt; 0 for line in lines_to_report)
            </attribute>
        </xpath>
        <xpath expr="//t[@t-call='payment.state_header']" position="attributes">
            <attribute name="t-if">show_total_amount</attribute>
        </xpath>
        <xpath expr="//th[@id='product_unit_price_header']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//th[@id='subtotal_header']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//t[@t-set='section_name_colspan']" position="attributes">
            <attribute name="t-value">
                2
                + (1 if show_line_values else 0)
                + (1 if display_discount else 0)
                + (1 if display_taxes else 0)
            </attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_name_xs']" position="attributes">
            <attribute name="t-att-colspan">
                2
                if not show_line_values
                else section_name_colspan
                - 1
                - (1 if display_discount else 0)
                - (1 if display_taxes else 0)
            </attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_name_sm']" position="attributes">
            <attribute name="t-att-colspan">
                2 if not show_line_values else section_name_colspan - (1 if display_taxes else 0)
            </attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_name']" position="attributes">
            <attribute name="t-att-colspan">
                (2 + (1 if display_taxes else 0)) if not show_line_values else section_name_colspan
            </attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_price']" position="attributes">
            <attribute name="t-if">show_line_values and show_section_total</attribute>
        </xpath>
        <xpath expr="//td[@name='td_combo_priceunit']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//td[@name='td_combo_subtotal']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_priceunit']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']" position="attributes">
            <attribute
                name="t-if"
            >show_line_values and not line.is_downpayment</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_priceunit']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//td[@name='td_section_group_total']" position="attributes">
            <attribute name="t-if">show_line_values</attribute>
        </xpath>
        <xpath expr="//div[@id='total' and @name='total']" position="attributes">
            <attribute name="t-if">show_total_amount</attribute>
        </xpath>
    </template>
</odoo>
