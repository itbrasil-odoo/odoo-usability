<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Grupo próprio para liberar o cockpit sem depender dos grupos contábeis.

      Motivação: os sócios precisam ver os números do financeiro, mas colocá-los
      em 'Accounting / Read-only' devolveria os menus de lançamentos contábeis e
      plano de contas — exatamente a queixa que originou este módulo. Assim eles
      ficam no mínimo ('Accounting / Invoicing') e recebem os números por aqui.
    -->

    <record id="res_groups_privilege_finance_cockpit" model="res.groups.privilege">
        <field name="name">Cockpit Financeiro</field>
        <field name="category_id" ref="base.module_category_accounting"/>
        <field name="sequence">80</field>
    </record>

    <record id="group_finance_viewer" model="res.groups">
        <field name="name">Visão do Sócio</field>
        <field name="sequence">10</field>
        <field name="comment">Vê o painel consolidado, o fluxo de caixa projetado e as contas a vencer, sem acesso à contabilidade.</field>
        <field name="privilege_id" ref="res_groups_privilege_finance_cockpit"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
